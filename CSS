/* Luxury Forensic Digital Style */
body {
  margin: 0;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  background: #0a0a0f;
  color: #f5f5f5;
  line-height: 1.6;
}

h1, h2 {
  font-weight: 700;
  color: #fff;
  letter-spacing: 1px;
}

a { color: #00ffc6; text-decoration: none; }
a:hover { text-decoration: underline; }

.hero {
  position: relative;
  height: 100vh;
  background: url("https://images.unsplash.com/photo-1642777649473-35706c938753?auto=format&fit=crop&w=1400&q=80") center/cover no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: white;
}
.hero .overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.65);
}
.hero-content {
  position: relative;
  z-index: 2;
  max-width: 800px;
  padding: 20px;
}
.hero h1 { font-size: 3rem; margin-bottom: 15px; }
.hero p { font-size: 1.3rem; margin-bottom: 25px; }
.hero-buttons .btn,
.hero-buttons .btn-outline {
  display: inline-block;
  margin: 10px;
  padding: 14px 24px;
  font-size: 1.1rem;
  border-radius: 6px;
  transition: 0.3s ease;
}
.btn {
  background: #00ffc6;
  color: #0a0a0f;
  font-weight: bold;
}
.btn:hover { background: #00d6a8; }
.btn-outline {
  border: 2px solid #00ffc6;
  color: #00ffc6;
}
.btn-outline:hover {
  background: #00ffc6;
  color: #0a0a0f;
}

.badges {
  padding: 60px 20px;
  text-align: center;
  background: #11111a;
}
.badge-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 20px;
  margin-top: 20px;
}
.badge {
  background: #1b1b25;
  border: 1px solid #00ffc6;
  padding: 20px;
  border-radius: 10px;
  font-weight: bold;
  font-size: 0.95rem;
}

/* Press Logos */
.press {
  padding: 50px 20px;
  text-align: center;
  background: #0f0f17;
}
.press h2 { margin-bottom: 25px; }
.press-logos {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 40px;
}
.press-logos img {
  height: 40px;
  filter: grayscale(100%) brightness(0.8);
  opacity: 0.8;
  transition: 0.3s ease;
}
.press-logos img:hover {
  filter: grayscale(0%);
  opacity: 1;
}

.about {
  padding: 60px 20px;
  background: #0f0f17;
  text-align: center;
}
.about p { max-width: 800px; margin: 15px auto; }

.contact {
  padding: 60px 20px;
  text-align: center;
  background: #11111a;
}
.contact iframe {
  margin-top: 20px;
  border-radius: 10px;
}
.contact-info {
  margin-top: 25px;
  font-size: 1.1rem;
}

footer {
  padding: 25px;
  text-align: center;
  background: #0a0a0f;
  font-size: 0.9rem;
  border-top: 1px solid #222;
}
